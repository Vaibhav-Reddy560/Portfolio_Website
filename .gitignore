# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Raw portrait source (7MB+) — only build-portrait.mjs reads this, nothing at
# runtime does. The generated public/portrait-amber.webp (32KB) is committed;
# this is kept locally so the script can be re-run if the photo changes.
public/image-1.png

# typescript
*.tsbuildinfo
next-env.d.ts
