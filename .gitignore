# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Raw portrait source (7MB+) — only build-portrait.mjs reads this, nothing at
# runtime does. The generated public/portrait-amber.webp (32KB) is committed;
# this is kept locally so the script can be re-run if the photo changes.
public/image-1.png

# Raw product screenshots — full-size sources for the optimized copies at
# public/work/easy-club/product.webp and public/work/opacitys/product.webp,
# which are what the site actually serves. Kept locally for future re-exports.
public/easyclub.png
public/opacitys.png

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local skill state — installed/cached per machine, not app code.
.agents/
.claude/
skills-lock.json
